{
  "name": "rolefoundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source AI career workspace: discover roles, prove skills, and build your learning path.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:pages": "STATIC_EXPORT=1 next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:demo": "tsx apps/worker/src/index.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --write src apps tests scripts *.ts *.json",
    "identity:start": "node scripts/local-identity.mjs start",
    "identity:stop": "node scripts/local-identity.mjs stop",
    "identity:invite": "node scripts/invite-local.mjs",
    "identity:dev": "node scripts/dev-identity.mjs",
    "identity:test": "node scripts/test-identity.mjs",
    "architecture:check": "node scripts/check-boundaries.mjs",
    "worker:start": "node --conditions=react-server --import tsx apps/worker/src/main.ts",
    "worker:local": "node scripts/local-worker.mjs",
    "resume:test": "vitest run --config vitest.resume.config.ts",
    "recovery:local": "node --conditions=react-server --import tsx scripts/recovery/local-rehearsal.mjs",
    "account:ledger": "node scripts/export-deletion-ledger.mjs",
    "account:resume": "node scripts/resume-deletion.mjs",
    "recovery:test": "node --test tests/recovery/*.test.mjs",
    "metrics:start": "node --conditions=react-server --import tsx apps/observability/src/main.ts",
    "metrics:local": "node scripts/local-metrics.mjs start",
    "metrics:probe": "node scripts/local-metrics.mjs probe",
    "metrics:rehearse": "node scripts/rehearse-metrics.mjs",
    "courses:check": "node --conditions=react-server --import tsx apps/course-links/src/main.ts",
    "courses:check:local": "node scripts/local-course-links.mjs",
    "gateway:eval": "node --import tsx apps/gateway-eval/src/main.ts",
    "i18n:check": "node --import tsx scripts/check-i18n.ts",
    "theme:generate": "node scripts/generate-dark-theme.mjs",
    "theme:check": "node scripts/generate-dark-theme.mjs --check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "fontkit": "2.0.4",
    "lucide-react": "^0.577.0",
    "mammoth": "1.13.0",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "pdfkit": "0.20.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tsx": "^4.21.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/fontkit": "2.0.9",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.23",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
