{
  "name": "rolefoundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source AI career workspace: discover roles, prove skills, and build your learning path.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:pages": "STATIC_EXPORT=1 next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker:demo": "tsx apps/worker/src/index.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --write src apps tests scripts *.ts *.json"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
