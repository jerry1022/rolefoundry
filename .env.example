# The public demo runs without credentials. Private modules 01–09 require a server deployment.
# Local helpers configure these automatically; see docs/CONFIGURATION.md.
NEXT_PUBLIC_BASE_PATH=
ROLEFOUNDRY_IDENTITY_ENABLED=false
ROLEFOUNDRY_APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server/worker only. Never use a NEXT_PUBLIC_ prefix for this credential.
SUPABASE_SERVICE_ROLE_KEY=

# Public jobs/courses/dictionary; private bookmarks and career workflows also require identity.
ROLEFOUNDRY_CATALOG_ENABLED=false
