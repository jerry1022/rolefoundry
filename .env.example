# The public demo runs without credentials. Private modules 01–10 require a server deployment.
# Local helpers configure these automatically; see docs/CONFIGURATION.md.
NEXT_PUBLIC_BASE_PATH=
ROLEFOUNDRY_IDENTITY_ENABLED=false
ROLEFOUNDRY_APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server/worker only. Never use a NEXT_PUBLIC_ prefix for this credential.
SUPABASE_SERVICE_ROLE_KEY=

# Public jobs/courses/dictionary; private bookmarks and career workflows also require identity.
ROLEFOUNDRY_CATALOG_ENABLED=false

# Server AND independent worker: identical deployment-owned approved JSON/CSV feed definitions.
# Empty by default; never use NEXT_PUBLIC_ or accept URLs from administrator forms.
# See docs/INGESTION_SETUP.md before adding a real authorized source.
ROLEFOUNDRY_APPROVED_FEEDS=[]

# Independent worker deployment environment; local worker helper inherits shell settings.
WORKER_LEASE_SECONDS=30
WORKER_CONCURRENCY=2
WORKER_DOCUMENT_CONCURRENCY=1
WORKER_FETCH_CONCURRENCY=1
WORKER_GENERAL_CONCURRENCY=2
